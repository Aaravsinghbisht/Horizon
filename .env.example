# Aegis local configuration — copy to .env.local
# All values are optional; the app has working defaults for each.
# Never commit real keys.

# ── Model access ──────────────────────────────────────────────────────────
# Default model is zai/glm-5.2 via Vercel AI Gateway (see agent/agent.ts).
AI_GATEWAY_API_KEY=

# ── Browser container (Docker) ────────────────────────────────────────────
COMPOSITER_CHROME_CONTAINER=compositer-chrome
# Skip Docker inspect and hardcode the CDP URL (host:port).
# COMPOSITER_CHROME_CDP_URL=

# ── Sandbox image ─────────────────────────────────────────────────────────
COMPOSITER_SANDBOX_IMAGE=compositer/eve-sandbox:local

# ── Razorpay (test keys) — used only for SAFE-site checkout ───────────────
# If unset, checkout runs in simulated demo mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR